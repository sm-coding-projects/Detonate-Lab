# Detonate Lab configuration.
# Fastest path:  ./scripts/init-env.sh   (generates a ready-to-run .env with strong secrets)
# Manual path:   cp .env.example .env  then fill the REQUIRED values below.

# --- Database ---
POSTGRES_USER=detonate
POSTGRES_PASSWORD=                 # REQUIRED — e.g. `openssl rand -hex 24`
POSTGRES_DB=detonate

# --- Application security ---
DL_ENVIRONMENT=production          # production refuses to start without a strong DL_SECRET_KEY
DL_SECRET_KEY=                     # REQUIRED — `openssl rand -hex 32` (min 32 chars)
DL_ALLOW_REGISTRATION=true         # set false to lock signups after creating accounts
DL_COOKIE_SECURE=false             # set true when serving over HTTPS (recommended in prod)

# --- Optional bootstrap admin (created on first start if both are set) ---
DL_ADMIN_EMAIL=
DL_ADMIN_PASSWORD=

# --- Networking / scaling ---
WEB_PORT=8080                      # host port for the web UI
WEB_CONCURRENCY=2                  # backend worker processes
