# Copy to `.env` and adjust as needed. Defaults work out of the box for local use.

# ---- Web ----
# Host port the app is published on → http://localhost:WEB_PORT
WEB_PORT=8080

# ---- Database ----
# CHANGE THESE before any non-local deployment.
POSTGRES_USER=detonate
POSTGRES_PASSWORD=detonate
POSTGRES_DB=detonate

# ---- Analysis engine ----
# 'static'    (default) — real but shallow: extracts strings from the submitted
#             file and matches them against signature rules. Never executes the
#             sample. Requires RETAIN_BYTES=true to have anything to read.
# 'simulated' — executes nothing and reads nothing; fabricates a plausible report
#             from the sample hash. Demo/UI use only, never analysis.
# A real CAPE/Cuckoo connector can be added in backend/src/services/connectors.
SANDBOX_CONNECTOR=static

# Max upload size in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600

# Retain submitted bytes in a quarantine volume (0600, never executed).
# REQUIRED by the 'static' connector — it has nothing to scan without them.
# Setting this false while SANDBOX_CONNECTOR=static makes every file submission
# come back "inconclusive". Note this means submitted malware persists on a volume.
RETAIN_BYTES=true

# Concurrent detonations.
ANALYSIS_CONCURRENCY=2

# ---- Rate limits (per IP, per minute) ----
RATE_MAX_REQUESTS=120
SUBMIT_MAX_REQUESTS=12
REPORT_MAX_REQUESTS=30
